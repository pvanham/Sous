{
  "name": "@sous/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "dev:client": "expo start --dev-client",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "ios:client": "expo start --ios --dev-client",
    "build:ios:dev": "npx eas-cli build --platform ios --profile development",
    "build:ios:sim": "npx eas-cli build --platform ios --profile development-simulator",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.36",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sous/config": "*",
    "@sous/types": "*",
    "@tanstack/react-query": "^5.90.19",
    "axios": "^1.15.0",
    "expo": "^57.0.9",
    "expo-auth-session": "~57.0.10",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "nativewind": "^5.0.0-preview.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-native": "0.86.3",
    "react-native-css": "^3.0.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-tab-view": "^4.3.2",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.12"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.1.18",
    "typescript": "~6.0.3"
  }
}
